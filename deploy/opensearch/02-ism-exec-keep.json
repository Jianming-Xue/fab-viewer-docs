{
  "policy": {
    "description": "块索引 mes-log-exec-* 生命周期：0~360d 热（可写）；360d 起转冷（只读，不删除）。按月建索引、不用 rollover，min_index_age 按索引创建时间算。",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          { "set_priority": { "priority": 100 } }
        ],
        "transitions": [
          { "state_name": "cold", "conditions": { "min_index_age": "360d" } }
        ]
      },
      {
        "name": "cold",
        "actions": [
          { "read_only": {} },
          { "set_priority": { "priority": 0 } }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["mes-log-exec-*"], "priority": 100 }
    ]
  }
}
