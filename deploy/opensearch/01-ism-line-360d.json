{
  "policy": {
    "description": "行索引 mes-log-line-* 生命周期：0~30d 热（可写）；30d 起转温（只读、副本 1、force merge 单段）；180d 起转冷；360d 删除。按天建索引、不用 rollover，min_index_age 按索引创建时间算。",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          { "set_priority": { "priority": 100 } }
        ],
        "transitions": [
          { "state_name": "warm", "conditions": { "min_index_age": "30d" } }
        ]
      },
      {
        "name": "warm",
        "actions": [
          { "read_only": {} },
          { "replica_count": { "number_of_replicas": 1 } },
          { "force_merge": { "max_num_segments": 1 } },
          { "set_priority": { "priority": 50 } }
        ],
        "transitions": [
          { "state_name": "cold", "conditions": { "min_index_age": "180d" } }
        ]
      },
      {
        "name": "cold",
        "actions": [
          { "set_priority": { "priority": 0 } }
        ],
        "transitions": [
          { "state_name": "delete", "conditions": { "min_index_age": "360d" } }
        ]
      },
      {
        "name": "delete",
        "actions": [
          { "delete": {} }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["mes-log-line-*"], "priority": 100 }
    ]
  }
}
