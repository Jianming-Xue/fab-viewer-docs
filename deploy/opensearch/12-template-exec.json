{
  "index_patterns": ["mes-log-exec-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "refresh_interval": "5s",
      "index.codec": "best_compression"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp":       { "type": "date" },
        "START_LINE_ID":    { "type": "keyword" },
        "END_LINE_ID":      { "type": "keyword" },
        "ENV":              { "type": "keyword" },
        "HOSTIP":           { "type": "keyword" },
        "SERVER_ID":        { "type": "keyword" },
        "SERVER_CATEGORY":  { "type": "keyword" },
        "SERVER_NUMBER":    { "type": "keyword" },
        "system.name":      { "type": "keyword" },
        "REQUEST_TYPE":     { "type": "keyword" },
        "ORDER_BY":         { "type": "long" },
        "START_TIME":       { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
        "END_TIME":         { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
        "LAST_LINE_TIME":   { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
        "CLOSE_TIME":       { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "EXEC_STATUS":      { "type": "keyword" },
        "REOPEN_LOG": {
          "type": "nested",
          "properties": {
            "PREV_END_TIME": { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
            "FIRST_TIME":    { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
            "GAP_MS":            { "type": "long" },
            "REOPENED_AT":       { "type": "date", "format": "strict_date_optional_time||epoch_millis" }
          }
        },
        "TOTAL_COST_MS":       { "type": "long" },
        "COST_SUM_MS":         { "type": "long" },
        "UNACCOUNTED_COST_MS": { "type": "long" },
        "COST_BREAKDOWN": {
          "type": "nested",
          "properties": {
            "ITEM":          { "type": "keyword" },
            "GROUP":         { "type": "keyword" },
            "COUNT":         { "type": "integer" },
            "SUM_MS":        { "type": "long" },
            "MAX_MS":        { "type": "long" },
            "FIRST_BEGIN_TS":{ "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
            "LAST_END_TS":   { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" }
          }
        },
        "INNER_RULES": {
          "type": "nested",
          "properties": {
            "NAME":       { "type": "keyword" },
            "START_TIME": { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
            "END_TIME":   { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" }
          }
        },
        "HANG_LIST": {
          "type": "nested",
          "properties": {
            "START_LINE_ID":  { "type": "keyword" },
            "END_LINE_ID":    { "type": "keyword" },
            "START_LINE_LOG": { "type": "keyword", "index": false, "doc_values": false },
            "END_LINE_LOG":   { "type": "keyword", "index": false, "doc_values": false },
            "HANG_REASON":    { "type": "keyword" },
            "HANG_COST_MS":   { "type": "long" },
            "START_TIME":     { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" },
            "END_TIME":       { "type": "date", "format": "yyyy/MM/dd HH:mm:ss.SSS||epoch_millis" }
          }
        },
        "RULENAME":    { "type": "keyword" },
        "LOTID":       { "type": "keyword" },
        "EQPID":       { "type": "keyword" },
        "PORTID":      { "type": "keyword" },
        "CARRIERID":   { "type": "keyword" },
        "USERID":      { "type": "keyword" },
        "TID":         { "type": "keyword" },
        "ERR_CODE":    { "type": "keyword" },
        "RULE_RESULT": { "type": "keyword" },
        "LOCK_SEQ":    { "type": "keyword" }
      }
    },
    "aliases": {
      "mes-log-exec-read": {}
    }
  },
  "_meta": {
    "index": "mes-log-exec-{env}-{yyyy.MM}，每月一个；块文档按块首行时刻选索引；读别名 mes-log-exec-read（不设写别名）",
    "mapping": "33 个字段、dynamic: strict；4 个 nested：REOPEN_LOG / COST_BREAKDOWN / INNER_RULES / HANG_LIST",
    "fields": "RULENAME / LOTID / EQPID / PORTID / CARRIERID / USERID / TID / ERR_CODE 可多值（keyword 数组）；CLOSE_TIME、REOPEN_LOG.REOPENED_AT 用 ISO 墙钟，其余时间字段用日志格式 yyyy/MM/dd HH:mm:ss.SSS"
  }
}
